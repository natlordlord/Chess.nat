[{"text": "Stell dir vor, jemand baut eine Schach-App. Ehrlich. Nur Schach. Das hält ungefähr zwei Wochen.", "words": [[0.09, "Stell"], [0.35, "dir"], [0.5, "vor"], [1.07, "jemand"], [1.34, "baut"], [1.57, "eine"], [1.76, "Schach-App"], [2.83, "Ehrlich"], [3.63, "Nur"], [4.0, "Schach"], [4.79, "Das"], [4.96, "hält"], [5.21, "ungefähr"], [5.72, "zwei"], [6.03, "Wochen"]], "end": 6.5}, {"text": "Puzzles, Bots, Ränge wie in League. Alles schön. Alles normal. Dann verliert Wolf eine Partie und will was anderes spielen.", "words": [[0.07, "Puzzles"], [0.84, "Bots"], [1.52, "Ränge"], [1.82, "wie"], [1.98, "in"], [2.09, "League"], [2.77, "Alles"], [3.12, "schön"], [3.88, "Alles"], [4.26, "normal"], [5.13, "Dann"], [5.39, "verliert"], [5.76, "Wolf"], [6.04, "eine"], [6.2, "Partie"], [6.72, "und"], [6.89, "will"], [7.05, "was"], [7.28, "anderes"], [7.58, "spielen"]], "end": 8.07}, {"text": "Also bauen wir Imposter nach. Raumstation, Sabotage, Sprachchat. Adri ist dreimal hintereinander der Imposter. Dreimal.", "words": [[0.05, "Also"], [0.39, "bauen"], [0.66, "wir"], [0.83, "Imposter"], [1.31, "nach"], [2.03, "Raumstation"], [3.01, "Sabotage"], [3.86, "Sprachchat"], [4.93, "Adri"], [5.46, "ist"], [5.66, "dreimal"], [6.09, "hintereinander"], [6.72, "der"], [6.85, "Imposter"], [7.81, "Dreimal"]], "end": 8.43}, {"text": "Dann wollen wir Kalorien tracken. Zehn Euro im Monat? Nö. Eingebaut. Sprechen oder Barcode, fertig. Mit Ranking gegen deine Freunde.", "words": [[0.05, "Dann"], [0.37, "wollen"], [0.62, "wir"], [0.78, "Kalorien"], [1.26, "tracken"], [2.11, "Zehn"], [2.42, "Euro"], [2.79, "im"], [2.9, "Monat"], [3.74, "Nö"], [4.58, "Eingebaut"], [5.68, "Sprechen"], [6.25, "oder"], [6.47, "Barcode"], [7.3, "fertig"], [8.24, "Mit"], [8.41, "Ranking"], [8.9, "gegen"], [9.17, "deine"], [9.41, "Freunde"]], "end": 9.95}, {"text": "Dann haben wir Bock auf Brawl Stars. Also bauen wir einfach Brawl Stars nach. Nat Stars. Weil wir Bock hatten. Das reicht hier als Grund.", "words": [[0.08,