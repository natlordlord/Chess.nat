{
  "regions": [
    "fra1"
  ],
  "cleanUrls": true,
  "functions": {
    "api/foods.js": {
      "maxDuration": 60
    },
    "api/muell.js": {
      "maxDuration": 30
    },
    "api/abfall.py": {
      "maxDuration": 60,
      "excludeFiles": "{voice,test,games,icons,supabase,node_modules,vendor,img,sounds,assets}/**"
    }
  },
  "headers": [
    {
      "source": "/(puzzles|voice|sounds|engine|vendor|icons)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(index.html|config.js|platform.js|pwa.js|version.json|voice/index.json|puzzles/index.json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
