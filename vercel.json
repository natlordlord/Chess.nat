{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(puzzles|voice|sounds|engine|vendor)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(index.html|config.js|platform.js|voice/index.json|puzzles/index.json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
